{
  "name": "milestone-shield-ai",
  "version": "0.1.0",
  "private": true,
  "description": "MilestoneShield AI — AI-assisted milestone payment platform",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
