# ── MilestoneShield AI Backend Configuration ─────────────────────
# Canonical local credential template for backend service.
# Copy this file to backend/.env and populate your PayPal Sandbox credentials.

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PayPal Sandbox REST API (Milestone 2A)
# WARNING: Only Sandbox URLs are permitted. Production endpoints are rejected.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Webhook ID (Follow-up after public HTTPS tunnel/deployment is configured)
PAYPAL_WEBHOOK_ID=

# Supabase Auth & PostgreSQL (Production Foundation)
# Project URL & keys from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
# Stored strictly on server; never expose in frontend client bundles
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Operational & Rate Limiting
# Set TRUST_PROXY=true only when running behind trusted reverse proxy (NGINX, Cloudflare, etc.)
TRUST_PROXY=false

# Future Integrations (Milestone 2B & 3)
ANTHROPIC_API_KEY=
DATABASE_URL=
