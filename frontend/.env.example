# ── MilestoneShield AI Frontend Configuration ─────────────────────
# Supabase Public API Configuration
# Populate with your Supabase Project URL and publishable Anon Key from:
# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# NOTE: Never store SUPABASE_SERVICE_ROLE_KEY or PAYPAL_CLIENT_SECRET here.
# Service keys are server-only and must never be exposed to frontend client bundles.
